{{#each categories}}
<section class="loot-picker-category">
  <h3 class="loot-picker-heading">{{this.label}}</h3>
  <div class="loot-picker-grid">
    {{#each this.icons}}
    <figure class="loot-picker-entry" data-icon="{{this.id}}" title="{{this.label}}">
      <img src="{{this.path}}" alt="{{this.label}}" />
      <figcaption>{{this.label}}</figcaption>
    </figure>
    {{/each}}
  </div>
</section>
{{/each}}
